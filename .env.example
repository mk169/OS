# Supabase-Zugangsdaten für Login + Geräte-Sync.
# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# Zu finden im Supabase-Dashboard unter: Project Settings -> API.
#
# Sind die Werte leer, läuft die App im lokalen Modus (ohne Login,
# ohne Cloud, kein Sync zwischen Geräten).

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key
